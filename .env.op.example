# 1Password CLI environment file for Ansible playbooks
# Copy to .env.op and fill in values. Do not commit .env.op.
#
# Run playbooks with:
#   op run --env-file=.env.op -- ansible-playbook playbooks/downgrade-inactive-full-admins.yml
#
# op:// references are resolved by op run before ansible-playbook starts.
MERAKI_DASHBOARD_API_KEY=op://YourVault/YourItem/credential
MERAKI_ORGANIZATION_ID=your-organization-id

# macOS only: required by Meraki Ansible action plugins on some macOS versions.
# https://developer.cisco.com/codeexchange/github/repo/meraki/dashboard-api-ansible/
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
