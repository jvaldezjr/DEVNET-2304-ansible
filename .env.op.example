# 1Password CLI secret references for Ansible playbooks
# Copy to .env.op and replace with your op:// references. Do not commit .env.op.
#
# Run playbooks with:
#   op run --env-file=.env.op -- ansible-playbook playbooks/list-organization-admins.yml
#
# Secret reference format: op://VaultName/ItemName/field_name
# In 1Password, open the item field menu and choose "Copy Secret Reference".
MERAKI_DASHBOARD_API_KEY=op://YourVault/YourItem/credential

# macOS only: required by Meraki Ansible action plugins on some macOS versions.
# https://developer.cisco.com/codeexchange/github/repo/meraki/dashboard-api-ansible/
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
